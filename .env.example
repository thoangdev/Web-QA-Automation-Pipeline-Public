# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
# Target app URL. Defaults to the saucedemo public test site so the template
# works out of the box. Override with your staging URL when you adopt it.
BASE_URL=https://www.saucedemo.com

# ── Auth (required — used by global auth setup) ───────────────────────────────
# Saucedemo defaults — username "standard_user", password "secret_sauce".
# Replace with your app's QA test account before pointing BASE_URL at it.
TEST_USER_USERNAME=standard_user
TEST_USER_PASSWORD=secret_sauce

# ── API (optional — used by API tests that call authenticated endpoints) ──────
API_KEY=

# ── CI notifications (optional) ───────────────────────────────────────────────
# Slack incoming webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Lighthouse CI GitHub App token — https://github.com/apps/lighthouse-ci
LHCI_GITHUB_APP_TOKEN=

# ── Jira integration (required for jira-qa-runner agent) ─────────────────────
# Your Jira Cloud base URL, no trailing slash.
JIRA_BASE_URL=https://your-org.atlassian.net

# Service account email used for Basic auth with the API token.
JIRA_EMAIL=qa-bot@your-org.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# NEVER commit the real value — this is a placeholder only.
JIRA_API_TOKEN=

# Project key where test defects are filed (e.g. QA, PROJ, APP).
JIRA_PROJECT_KEY=QA

# Optional: override the 5-minute default environment readiness poll timeout.
# ENV_CHECK_TIMEOUT_MS=300000
