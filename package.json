{
  "name": "dispel-e2e-monorepo",
  "version": "1.0.0",
  "description": "Multi-product E2E testing monorepo for Dispel with ZAP integration, Tuskr mapping, and Slack notifications",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:stig": "playwright test --project=stig",
    "test:abb": "playwright test --project=abb",
    "test:dsmd": "playwright test --project=dsmd",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "playwright:codegen:stig": "playwright codegen --target=\"./projects/stig/pages/\" --load-storage=\"./projects/stig/fixtures/auth.json\"",
    "playwright:codegen:abb": "playwright codegen --target=\"./projects/abb/pages/\" --load-storage=\"./projects/abb/fixtures/auth.json\"",
    "playwright:codegen:dsmd": "playwright codegen --target=\"./projects/dsmd/pages/\" --load-storage=\"./projects/dsmd/fixtures/auth.json\"",
    "report": "playwright show-report",
    "install": "playwright install",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "dispel",
    "zap",
    "security",
    "automation"
  ]
}
